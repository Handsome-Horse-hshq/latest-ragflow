# 虚拟环境
.venv/
venv/
# refchecker 的隔离环境：依赖很重（torch/spacy/litellm），刻意与主 venv 分开，
# 避免顶掉主环境里的 numpy / scikit-learn。
.venv-refchecker/
# 本地模型缓存
.model-cache/

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 测试与类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 数据与实验产物（保留目录结构，忽略内容）
data/raw/*
data/processed/*
!data/raw/climate-fever.jsonl
!data/processed/climate_fever_v1/
!data/processed/climate_fever_v1/**
outputs/predictions/*
outputs/metrics/*
outputs/figures/*
# RAGChecker 的输入/输出与模型关系文件：体量大且随模型变化，不入库，
# 谱系由 outputs/ragchecker*/*_model_run.json 记录（同样不入库）。
# 用通配覆盖 ragchecker/、ragchecker_v2/ 及以后的版本目录。
outputs/ragchecker*/*
!outputs/metrics/climate_fever_threshold_search.json
!**/.gitkeep

# 编辑器
.vscode/
.idea/
.DS_Store
