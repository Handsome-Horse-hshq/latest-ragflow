# 虚拟环境
.venv/
venv/
# refchecker 的隔离环境：依赖很重（torch/spacy/litellm），刻意与主 venv 分开，
# 避免顶掉主环境里的 numpy / scikit-learn。
.venv-refchecker/
# 本地模型缓存
.model-cache/

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 测试与类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 数据与实验产物
# 论文用到的数据集与实验结果**入库**：v2 数据集、RefChecker / flan-t5 的
# 输入输出与关系文件、谱系清单、全部指标与图表。这样仓库本身就能复现主结果，
# 不必重跑约 40 分钟的模型推理。总量约 17 MB，最大单文件约 1.1 MB。
# 这些文件的换行必须原样保留（SHA-256 写在清单里），见 .gitattributes。
data/raw/*
data/processed/*
!data/raw/climate-fever.jsonl
!data/processed/climate_fever_v1/
!data/processed/climate_fever_v1/**
!data/processed/climate_fever_v2/
!data/processed/climate_fever_v2/**
# AVeriTeC（CC-BY-NC-4.0：非商业使用并注明出处，见 data/raw/averitec/SOURCE.md）：
# 原始文件、处理后的数据集与 outputs/ragchecker_averitec/ 都入库。
!data/raw/averitec/
!data/raw/averitec/**
!data/processed/averitec_v1/
!data/processed/averitec_v1/**
# 仍然不入库：断点续跑的中间进度与原子写入的临时文件。
# 例外：作废的 flan-t5 输出（含一个 partial 文件）作为缺陷证据保留，见其 README.txt。
outputs/**/*.partial.jsonl
outputs/**/*.partial.json
!outputs/ragchecker_v2/_invalid_flan_t5_sum_logprob/*.partial.jsonl
outputs/**/*.tmp
# CONFACT 的上游仓库没有声明许可证，带它原文的文件一律不入库：原始文件与处理后
# 的样本已被上面的 data/ 规则排除，这里再排除含网页段落的 NLI 输入输出。
# 不含原文的指标（outputs/metrics/confact_reliability/）照常入库。
outputs/ragchecker_confact/

# 本地密钥：只放在这台机器上，永远不入库。
.env
.env.*

# 编辑器
.vscode/
.idea/
.DS_Store
